{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stellar-members",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Public configuration, also served to the app on /api/config.
  // Secrets are pushed with `make deploy-secrets`, see .dev.vars.example.
  "vars": {
    // One worker serves every network it is configured for; the caller names
    // the one it wants with `?network=`. A network is served once it has all
    // five `<NETWORK>_` settings, the fifth being the secret attester key.
    "TESTNET_PASSPHRASE": "Test SDF Network ; September 2015",
    "TESTNET_RPC_URL": "https://soroban-testnet.stellar.org",
    "TESTNET_CONTRACT_ID": "CB5O6XFNHMMW6H42M7H3HOA736EOGHNTBWUA5B3T4LPIJXRFQ6WCLFZE",
    "TESTNET_ATTESTER_PUBLIC": "GBAWJQEPO6KF3EWRYV4NQXJOUSCEYY3JNL6GZWKUKWAJKXOMPYUDPQ6C",
    // Mainnet is not served yet: MAINNET_CONTRACT_ID, MAINNET_ATTESTER_PUBLIC
    // and the secret are still missing, so the two below sit here unused
    // until the contract is deployed and the attester key exists.
    "MAINNET_PASSPHRASE": "Public Global Stellar Network ; September 2015",
    "MAINNET_RPC_URL": "https://rpc.lightsail.network",
    "IPFS_GATEWAY": "https://ipfs.filebase.io/ipfs/",
    "PGATLAS_URL": "https://api.pgatlas.xyz",
    // "discord": role comes from the SDF Discord roles (migration),
    // "verified": every new member is Verified.
    "ROLE_SOURCE": "discord",
    "DISCORD_GUILD_ID": "897514728459468821",
    // Stellar Developers server roles: Pilot 3, Navigator 2, Pathfinder 1, Verified 0
    "DISCORD_ROLE_MAP": "{\"1082331251899379762\":3,\"1082353855041392731\":2,\"1082357854926807111\":1,\"1116373909504274534\":0}",
    "DISCORD_CLIENT_ID": "1549691188368642078",
    "GITHUB_CLIENT_ID": "Ov23lifVUXCy7ULe8eHz",
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      // any id, unique per account
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
}
