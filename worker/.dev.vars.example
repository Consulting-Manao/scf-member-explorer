# Copy to .dev.vars for local development. Any public var of wrangler.jsonc can
# be overridden here too, for the local run only: `make deploy-secrets` leaves
# every name wrangler.jsonc declares behind and pushes the rest, so an override
# stays local. Removing a line here never removes a secret;
# `wrangler secret delete <NAME>` does.

# Secret key of the attester identity, one per network of NETWORKS. Signs auth
# entries and OAuth claims for that network only, never pays fees.
TESTNET_ATTESTER_SECRET=
# OAuth apps, see README. A GitHub app holds a single callback URL, so the one
# for localhost is a second app: its client id belongs here too, overriding the
# deployed one of wrangler.jsonc.
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Filebase IPFS pinning token
FILEBASE_TOKEN=
