{
  "name": "stellar-members",
  "private": true,
  "license": "BSD-3-Clause",
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:local": "bun run dev:api & bun run dev:app; wait",
    "dev:api": "bun scripts/dev-api.ts",
    "dev:app": "API_PROXY=http://127.0.0.1:8787 vite --host 127.0.0.1 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "tsc -b",
    "lint": "prettier -c . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "smoke": "bun scripts/smoke.ts",
    "card": "rsvg-convert -w 1200 -h 630 assets/social-card.svg -o public/social-card.png"
  },
  "dependencies": {
    "@creit-tech/stellar-wallets-kit": "npm:@jsr/creit-tech__stellar-wallets-kit@^2.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@ipld/car": "^5.4.7",
    "@stellar/stellar-sdk": "^17.1.0",
    "@tanstack/query-async-storage-persister": "^5.103.0",
    "@tanstack/react-query": "^5.103.0",
    "@tanstack/react-query-persist-client": "^5.103.0",
    "@tanstack/react-router": "^1.170.36",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.8",
    "idb-keyval": "^6.3.0",
    "ipfs-car": "^3.1.0",
    "lucide-react": "^1.46.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "stellar-membership": "workspace:*",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.10",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "multiformats": "^14.0.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.132.0"
  }
}
