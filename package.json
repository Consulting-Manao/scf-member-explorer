{
  "name": "stellar-membership",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "workspaces": [
    "bindings",
    "dapp",
    "scripts",
    "shared",
    "worker"
  ],
  "scripts": {
    "dev": "bun scripts/dev-api.ts & bun run --cwd dapp dev; wait",
    "build": "bun run typecheck && bun run --cwd dapp build",
    "typecheck": "tsc -p shared && tsc -p worker && tsc -p dapp && tsc -p scripts",
    "deploy": "bun run --cwd worker deploy",
    "lint": "prettier -c . && eslint .",
    "format": "prettier --write .",
    "test": "bun run --cwd shared test && bun run --cwd worker test && bun run --cwd dapp test",
    "smoke": "bun scripts/smoke.ts",
    "cf-typegen": "bun run --cwd worker cf-typegen"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
